[Unit]
Description=TINA Product API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tina-med-demo/backend
EnvironmentFile=/opt/tina-med-demo/.env
ExecStart=/opt/tina-med-demo/.venv/bin/uvicorn app.product_api:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
