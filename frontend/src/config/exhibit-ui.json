          "visible": true,
          "priority": 65,
          "order": 50,
          "presentation": "fact-grid",
          "interactionRole": "read",
          "fields": ["dosage_form", "specification", "package_description", "storage"]
        },
        {
          "id": "traceability",
          "label": "完整追溯资料",
          "visible": true,
          "priority": 25,
          "order": 60,
          "presentation": "metadata",
          "interactionRole": "progressive",
          "fields": ["manufacturer", "approval_number", "barcode", "source"]
        }
      ]
    },
    "editorial": {
      "name": "Pharmaceutical Editorial",
      "label": "药品编辑设计",
      "description": "以药盒标签、说明书折页和展品目录为参照，用尺度与留白建立记忆点。",
      "assistant": {
        "mode": "editorial-mark",
        "greeting": "从目录中选一个问题，或直接告诉我你想了解什么。"
      },
      "hero": {
        "leadField": "description",
        "factFields": ["dosage_form", "specification"],
        "visual": "label-study"
      },
      "sections": [
        {
          "id": "profile",
          "label": "产品札记",
          "visible": true,
          "priority": 100,
          "order": 10,
          "presentation": "story",
          "interactionRole": "read",
          "fields": ["description", "appearance"]
        },
        {
          "id": "purpose",
          "label": "推荐场景",
          "visible": true,
          "priority": 95,
          "order": 20,
          "presentation": "feature",
          "interactionRole": "assistant-context",
          "fields": ["indications"]
        },
        {
          "id": "usage",
          "label": "使用注记",
          "visible": true,
          "priority": 90,
          "order": 30,
          "presentation": "steps",
          "interactionRole": "assistant-context",
          "fields": ["usage"]
        },
        {
          "id": "essentials",
          "label": "形式与包装",
          "visible": true,
          "priority": 70,
          "order": 40,
          "presentation": "fact-grid",
          "interactionRole": "read",
          "fields": ["dosage_form", "specification", "package_description", "storage"]
        },
        {
          "id": "safety",
          "label": "边界声明",
          "visible": true,
          "priority": 98,
          "order": 50,
          "presentation": "warning",
          "interactionRole": "read",
          "fields": ["warnings", "contraindications"]
        },
        {
          "id": "traceability",
          "label": "样品档案",
          "visible": true,
          "priority": 30,
          "order": 60,
