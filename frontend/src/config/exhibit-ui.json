{
  "$schema": "./exhibit-ui.schema.json",
  "version": 1,
  "defaultVariant": "clinical",
  "medicines": {
    "medicine-001": {
      "defaultVariant": "clinical",
      "availableVariants": ["clinical", "companion", "editorial"]
    },
    "medicine-002": {
      "defaultVariant": "companion",
      "availableVariants": ["clinical", "companion", "editorial"]
    },
    "medicine-003": {
      "defaultVariant": "editorial",
      "availableVariants": ["clinical", "companion", "editorial"]
    }
  },
  "variants": {
    "clinical": {
      "name": "Clinical Precision",
      "label": "临床精确",
      "description": "以检验标签和临床记录为参照，先给结论，再展开依据。",
      "assistant": {
        "mode": "supporting",
        "greeting": "需要核对哪一项样品资料？"
      },
      "hero": {
        "leadField": "indications",
        "factFields": ["dosage_form", "specification", "package_description"],
        "visual": "precision-pack"
      },
      "sections": [
        {
          "id": "essentials",
          "label": "样品规格",
          "visible": true,
          "priority": 100,
          "order": 10,
          "presentation": "fact-grid",
          "interactionRole": "read",
          "fields": ["dosage_form", "specification", "package_description", "storage"]
        },
        {
          "id": "purpose",
          "label": "适用场景",
          "visible": true,
          "priority": 95,
          "order": 20,
          "presentation": "feature",
          "interactionRole": "assistant-context",
          "fields": ["indications"]
        },
        {
          "id": "usage",
          "label": "模拟使用方式",
          "visible": true,
          "priority": 90,
          "order": 30,
          "presentation": "steps",
          "interactionRole": "assistant-context",
          "fields": ["usage"]
        },
        {
          "id": "safety",
          "label": "重要提醒",
          "visible": true,
          "priority": 98,
          "order": 40,
          "presentation": "warning",
          "interactionRole": "read",
          "fields": ["warnings", "contraindications"]
        },
        {
          "id": "profile",
          "label": "样品说明",
          "visible": true,
          "priority": 60,
          "order": 50,
          "presentation": "story",
          "interactionRole": "read",
          "fields": ["description", "appearance"]
        },
        {
          "id": "traceability",
          "label": "追溯信息",
          "visible": true,
          "priority": 30,
          "order": 60,
          "presentation": "metadata",
          "interactionRole": "progressive",
          "fields": ["manufacturer", "approval_number", "barcode", "source"]
        }
      ]
    },
    "companion": {
      "name": "TINA Companion",
      "label": "TINA 陪伴",
