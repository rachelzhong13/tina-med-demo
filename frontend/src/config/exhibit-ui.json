      "assistant": {
        "mode": "character",
        "greeting": "你好，我可以陪你读懂这份展品资料。"
      },
      "hero": {
        "leadField": "description",
        "factFields": ["specification", "usage"],
        "visual": "care-object"
      },
      "sections": [
        {
          "id": "purpose",
          "label": "这件样品想表达什么",
          "visible": true,
          "priority": 100,
          "order": 10,
          "presentation": "care",
          "interactionRole": "assistant-context",
          "fields": ["indications"]
        },
        {
          "id": "usage",
