          "visible": true,
          "priority": 95,
          "order": 20,
          "presentation": "steps",
          "interactionRole": "assistant-context",
          "fields": ["usage"]
        },
        {
          "id": "safety",
          "label": "先记住这件事",
          "visible": true,
          "priority": 98,
          "order": 30,
          "presentation": "warning",
          "interactionRole": "read",
          "fields": ["warnings", "contraindications"]
        },
        {
          "id": "profile",
          "label": "样品故事",
          "visible": true,
          "priority": 75,
          "order": 40,
          "presentation": "story",
          "interactionRole": "read",
          "fields": ["description", "appearance"]
        },
        {
          "id": "essentials",
