{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tina.demo/schemas/exhibit-ui.schema.json",
  "title": "TINA exhibition UI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultVariantByMedicine", "variants"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 3 },
    "defaultVariantByMedicine": { "type": "object", "additionalProperties": { "$ref": "#/$defs/variantId" } },
    "variants": { "type": "object", "required": ["botanical-minimal", "oriental-editorial", "botanical-future"], "additionalProperties": { "$ref": "#/$defs/variant" } }
  },
  "$defs": {
    "variantId": { "enum": ["botanical-minimal", "oriental-editorial", "botanical-future"] },
    "medicineField": { "enum": ["generic_name", "manufacturer", "approval_number", "barcode", "category", "dosage_form", "specification", "package_description", "appearance", "storage", "indications", "usage", "contraindications", "warnings", "description", "source"] },
    "assistant": { "type": "object", "additionalProperties": false, "required": ["mode", "greeting"], "properties": { "mode": { "enum": ["botanical-guide", "editorial-guide", "future-guide"] }, "greeting": { "type": "string", "minLength": 1 } } },
    "hero": { "type": "object", "additionalProperties": false, "required": ["leadField", "factFields", "visual"], "properties": { "leadField": { "$ref": "#/$defs/medicineField" }, "factFields": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/medicineField" } }, "visual": { "enum": ["botanical-specimen", "editorial-herbarium", "botanical-optical"] } } },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "visible", "priority", "order", "presentation", "interactionRole", "fields"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "label": { "type": "string", "minLength": 1 }, "visible": { "type": "boolean" }, "priority": { "type": "integer", "minimum": 0, "maximum": 100 }, "order": { "type": "integer", "minimum": 0 },
        "presentation": { "enum": ["botanical-prose", "herbarium-story", "quiet-usage", "specimen-ledger", "safety-note", "editorial-index", "catalogue-story", "catalogue-grid", "vertical-usage", "cinnabar-safety", "luminous-lead", "orbit-usage", "glass-safety", "translucent-story", "optical-ledger", "archive"] },
        "interactionRole": { "enum": ["read", "progressive", "assistant-context"] }, "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/medicineField" } }
      }
    },
    "variant": { "type": "object", "additionalProperties": false, "required": ["id", "name", "label", "description", "assistant", "hero", "sections"], "properties": { "id": { "$ref": "#/$defs/variantId" }, "name": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "assistant": { "$ref": "#/$defs/assistant" }, "hero": { "$ref": "#/$defs/hero" }, "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } } } }
  }
}
