APP_ENV=production
DATABASE_PATH=data/tina_med.db

# TINA OpenAI-compatible API. Keep the real key only on the server.
LLM_API_KEY=
LLM_BASE_URL=http://api.twstars.com:3000/v1
LLM_MODEL=ornith:35b
LLM_TIMEOUT=180

# Chat API calls the independent product API for the current product context.
# Leave empty only when running the compatibility app locally.
PRODUCT_API_BASE_URL=
PRODUCT_API_TIMEOUT=10

PUBLIC_BASE_URL=https://iotns.org.cn/TINAapimed
CORS_ORIGINS=http://localhost:5173,https://rachelzhong13.github.io

# Used when building the frontend for the existing server deployment.
VITE_BASE_PATH=/TINAapimed/
VITE_API_BASE_URL=/TINAapimed/api
